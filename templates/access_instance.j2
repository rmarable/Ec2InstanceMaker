{% endif %}

ec2_InstanceName = terraform_output('instance_name_index')

{% if is_windows %}
winItemAdminPw_tf = []
for winItemId_tf in str(ec2_InstanceId).split(","):
    winItemPw_tf = subprocess.run(
        ['aws', 'ec2', 'get-password-data', '--instance-id', winItemId_tf, '--priv-launch-key', ec2_keypair + '.pem'],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        cwd=instance_data_dir,
    )
    adminpw_tf = jq('..|.PasswordData?').transform(text=winItemPw_tf.stdout.decode('utf-8'), text_output=True)
    adminpw_tf = adminpw_tf.replace('\"', '').strip()
    winItemAdminPw_tf.append(adminpw_tf)
windows_AdministratorPassword = ','.join(winItemAdminPw_tf)

{% endif %}
# Create a temporary CSV file and table header for the instance state data.

csv_fd, csvTempFile = tempfile.mkstemp(prefix='_csvTempFile_' + instance_serial_number + '_', suffix='.csv')
os.close(csv_fd)

# For a Windows build this file holds the decrypted local Administrator
# password in plaintext. The explicit os.remove() at the bottom of this
# script only runs on the success path, so a CTRL-C at the menu prompt --
# or any non-numeric input, since int(input()) raises ValueError and
# nothing catches it -- used to leave those passwords sitting in /tmp
# indefinitely, directly contradicting the comment down there claiming the
# file is always removed. atexit covers every ordinary interpreter exit,
# including an unhandled exception and sys.exit().

def _remove_csv_temp_file():
    if os.path.exists(csvTempFile):
        os.remove(csvTempFile)


atexit.register(_remove_csv_temp_file)

csv_file = open(csvTempFile, 'w')
{% if is_windows %}

csv_file.write('Item,Instance Name,IP Address,Adminstrator Password\n')
{% else %}
csv_file.write('Item,Instance Name,IP Address,Instance ID\n')
{% endif %}

csv_file.close()
csv_file = open(csvTempFile, 'a')

{% if is_windows %}
windows_menu_items = len(ec2_InstanceName.split(','))
for w, x, y, z in zip(menuCount(1, windows_menu_items), ec2_InstanceName.split(','), ec2_IpAddress.split(','), windows_AdministratorPassword.split(',')):
    element = str(w) + ',' + x + ',' + y + ',' + z + '\n'
    csv_file.write(element)
csv_file.close()
csv_file = open(csvTempFile, 'r')
windows_InstanceTable = from_csv(csv_file)
csv_file.close()
