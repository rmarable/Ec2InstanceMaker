# Ask which family member to open a Remote Desktop tunnel to.
#
# Bypass the prompt if the user already indicated which host is desired.

if menu_index == 0:
    print('Select an instance to access using Remote Desktop:')
    # int(input()) used to be guarded only for KeyboardInterrupt, so any
    # non-numeric entry raised ValueError and exited with a traceback --
    # while leaving the decrypted-password temp CSV behind, before the
    # atexit handler existed. An out-of-range choice silently indexed the
    # wrong family member, and a negative one indexed from the end.
    try:
        menuchoice = int(input())
    except KeyboardInterrupt:
        print('')
        sys.exit(1)
    except ValueError:
        print('')
        print('That is not a number.')
        sys.exit(1)
    if menuchoice < 1 or menuchoice > windows_menu_items:
        print('')
        print('Please choose a number between 1 and ' + str(windows_menu_items) + '.')
        sys.exit(1)
    print('')
else:
    menuchoice = menu_index
{% else %}
menuchoice = 1
{% endif %}

rdp_target_index = menuchoice - 1
rdp_instance_id = ec2_InstanceId.split(',')[rdp_target_index]
rdp_instance_name = ec2_InstanceName.split(',')[rdp_target_index]

# Open an SSM Session Manager port-forwarding tunnel for Remote Desktop
# instead of exposing port 3389 to any CIDR. Point a Remote Desktop client
# at localhost on rdp_local_port once the tunnel is up; Ctrl+C closes it.

# A hardcoded port meant two concurrent tunnels collided: the second
# `aws ssm start-session` failed while the first was still bound, and an
# operator reconnecting to localhost:13389 reached the *first* instance
# while this script's output claimed it had opened a tunnel to the second.
# Pick a free port instead, and print the one actually used.
_rdp_socket = socket.socket()
_rdp_socket.bind(('127.0.0.1', 0))
rdp_local_port = str(_rdp_socket.getsockname()[1])
_rdp_socket.close()
print('Opening a Remote Desktop tunnel to: ' + rdp_instance_name)
print('Connect your Remote Desktop client to: localhost:' + rdp_local_port)
print('Press Ctrl+C to close the tunnel when finished.')
print('')
try:
    subprocess.run(
        [
            'aws', 'ssm', 'start-session',
            '--target', rdp_instance_id,
            '--region', region,
            '--document-name', 'AWS-StartPortForwardingSession',
            '--parameters', '{"portNumber":["3389"],"localPortNumber":["' + rdp_local_port + '"]}',
        ],
        cwd=instance_data_dir,
    )
except KeyboardInterrupt:
    pass
print('')
print('Closed the Remote Desktop tunnel to: ' + rdp_instance_name)
print('')
print('Reprint this table and reopen the tunnel:')
if menu_index == 0:
    print('./access_instance.py -N {{ instance_name }}')
else:
    print('./access_instance.py -N {{ instance_name }} -m ' + str(menu_index))
print('')

{% else %}
# Compute the number of instances deployed with this instance_name.
#
# This was len(ec2_IpAddress) -- the *character* length of the comma-joined
# IP string, not the number of instances. It only appeared to work because
# zip() below stops at the shortest sequence, so the oversized range was
# silently truncated. Any other use of the value, or a bounds check against
# it, would have been wrong.

ec2_menu_items = len(ec2_IpAddress.split(','))

# Append the instance state data to the temporary CSV header file.

for w, x, y, z in zip(menuCount(1, ec2_menu_items), ec2_InstanceName.split(','), ec2_IpAddress.split(','), ec2_InstanceId.split(',')):
    element = str(w) + ',' + x + ',' + y + ',' + z + '\n'
    csv_file.write(element)
csv_file.close()
csv_file = open(csvTempFile, 'r')
ec2_InstanceTable = from_csv(csv_file)
csv_file.close()

{% if count > 1 %}
# Create a menu to assist the operator with connecting to the new
# instances via SSM Session Manager.
#
# Bypass the menu if the user already indicated which host is desired.

if menu_index == 0:
    print('')
    print(ec2_InstanceTable)
    print('')
    print('Select an instance to access using SSM Session Manager:')
    try:
        menuchoice = int(input())
    except KeyboardInterrupt:
        print('')
        sys.exit(1)
    print('')
else:
    menuchoice = menu_index

with open(csvTempFile, newline='') as infh:
    reader = csv.reader(infh)
    for row in reader:
        if str(row[0]) == str(menuchoice):
            ssh_hostname = row[1]
            ssh_ip_address = row[2]
            ssh_instance_id = row[3]
            print('Opening an SSM Session Manager connection to: ' + ssh_hostname)
            print('')
            if ssh_ip_address == '':
                    print('*** ERROR ***')
                    print('No IP address found for: ' + ssh_instance_id)
                    print('Please power on the instance and retry!')
                    print('Aborting...')
                    sys.exit(1)
            else:
                try:
                    subprocess.run(
                        [
                            'aws', 'ssm', 'start-session',
                            '--target', ssh_instance_id,
                            '--region', region,
                            '--document-name', 'AWS-StartInteractiveCommand',
                            '--parameters', '{"command":["sudo su - ' + ec2_user + '"]}',
                        ],
                        cwd=instance_data_dir,
                    )
                except KeyboardInterrupt:
                    pass

{% else %}
# Connect to the new instance via SSM Session Manager.
#
# If the IP address is missing, return an error and abort as the instance being
# accessed is probably powered off.

if ec2_IpAddress == '':
    print('')
    print('*** ERROR ***')
    print('No IP address found! Please power on the instance and retry.')
    print('Aborting...')
    sys.exit(1)
else:
    try:
        subprocess.run(
            [
                'aws', 'ssm', 'start-session',
                '--target', ec2_InstanceId,
                '--region', region,
                '--document-name', 'AWS-StartInteractiveCommand',
                '--parameters', '{"command":["sudo su - ' + ec2_user + '"]}',
            ],
            cwd=instance_data_dir,
        )
    except KeyboardInterrupt:
        pass
{% endif %}

# Print reconnection information to the console.

print('')
{% if count > 1 %}
print('Reconnect to ' + ssh_hostname + ' by running this command:')
{% else %}
print('Reconnect to ' + instance_name + ' by running this command:')
{% endif %}
if menu_index == 0:
    print('./access_instance.py -N {{ instance_name }}')
else:
    print('./access_instance.py -N {{ instance_name }} -m ' + str(menu_index))
{% endif %}

# Cleanup and exit.
#
# Always remove the temp CSV, regardless of count -- for Windows builds it
# holds the decrypted Administrator password in plaintext and must not be
# left behind in /tmp between runs. The atexit handler registered next to
# mkstemp() above is what actually guarantees this on the paths that do
# not reach here; this call just removes it as early as possible.

_remove_csv_temp_file()
sys.exit(0)
