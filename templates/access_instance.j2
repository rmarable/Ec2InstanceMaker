# These used to be four separate `terraform show | grep X | awk '{print $3}'`
# pipelines run with shell=True. Reading the outputs as JSON instead removes
# every shell invocation from this script, drops the grep/awk dependency,
# and stops depending on the exact column layout of `terraform show` -- a
# human-readable format with no stability guarantee, where a renamed output
# or an extra space silently yielded an empty string rather than an error.

subprocess.run(['terraform', 'refresh'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, cwd=instance_data_dir)
tf_output = subprocess.run(['terraform', 'output', '-json'], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, cwd=instance_data_dir)
if tf_output.returncode != 0:
    print('Could not read the Terraform outputs for {{ instance_name }}.')
    print('Is ' + instance_data_dir + ' still present, and has the instance been built?')
    print('Aborting...')
    sys.exit(1)
try:
    terraform_outputs = json.loads(tf_output.stdout.decode('utf-8') or '{}')
except json.JSONDecodeError:
    print('Terraform returned output this script could not parse.')
    print('Aborting...')
    sys.exit(1)


def terraform_output(name):
    return str(terraform_outputs.get(name, {}).get('value', '')).strip()


ec2_IpAddress = terraform_output('instance_ip_addresses')

{% if count > 1 %}
# Parse the instanceId(s).
{% else %}
# Parse the instanceId.
{% endif %}

ec2_InstanceId = terraform_output('instance_id_list')

# Abort if the menu table is empty because no instance(s) exist(s).

if len(ec2_InstanceId) == 0:
    print('No instance(s) found!')
    print('Aborting...')
    sys.exit(1)

{% if count > 1 %}
# Parse the names of the instances.
{% else %}
