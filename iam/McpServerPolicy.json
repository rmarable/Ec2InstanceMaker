{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DenyStateChangesOnResourcesThisToolkitDidNotCreate",
            "Effect": "Deny",
            "Action": [
                "ec2:TerminateInstances",
                "ec2:StopInstances",
                "ec2:StartInstances",
                "ec2:RebootInstances",
                "ec2:DeleteVolume",
                "ec2:DetachVolume"
            ],
            "Resource": "arn:aws:ec2:*:*:instance/*",
            "Condition": {
                "StringNotEquals": {
                    "ec2:ResourceTag/ManagedBy": "Ec2InstanceMaker"
                }
            }
        },
        {
            "Sid": "DenyAnythingOutsideTheAllowedRegions",
            "Effect": "Deny",
            "NotAction": [
                "iam:*",
                "sts:*",
                "support:*"
            ],
            "Resource": "*",
            "Condition": {
                "StringNotEquals": {
                    "aws:RequestedRegion": "<ALLOWED_REGIONS>"
                }
            }
        },
        {
            "Sid": "DenyInstanceTypesOutsideTheAllowlist",
            "Effect": "Deny",
            "Action": [
                "ec2:RunInstances",
                "ec2:RequestSpotInstances"
            ],
            "Resource": "*",
            "Condition": {
                "StringNotEquals": {
                    "ec2:InstanceType": "<ALLOWED_INSTANCE_TYPES>"
                }
            }
        },
        {
            "Sid": "DenyCreatingRolesWithoutThePermissionsBoundary",
            "Effect": "Deny",
            "Action": [
                "iam:CreateRole"
            ],
            "Resource": "*",
            "Condition": {
                "StringNotEquals": {
                    "iam:PermissionsBoundary": "arn:aws:iam::<AWS_ACCOUNT_ID>:policy/Ec2InstanceMakerCreatedRoleBoundary"
                }
            }
        },
        {
            "Sid": "DenyTamperingWithTheBoundaryOrThisRole",
            "Effect": "Deny",
            "Action": [
                "iam:CreatePolicyVersion",
                "iam:DeletePolicy",
                "iam:DeletePolicyVersion",
                "iam:SetDefaultPolicyVersion",
                "iam:DeleteRolePermissionsBoundary",
                "iam:PutRolePermissionsBoundary",
                "iam:AttachRolePolicy",
                "iam:PutRolePolicy",
                "iam:DeleteRole",
                "iam:UpdateAssumeRolePolicy"
            ],
            "Resource": [
                "arn:aws:iam::<AWS_ACCOUNT_ID>:policy/Ec2InstanceMakerCreatedRoleBoundary",
                "arn:aws:iam::<AWS_ACCOUNT_ID>:policy/Ec2InstanceMakerMcpServerPolicy",
                "arn:aws:iam::<AWS_ACCOUNT_ID>:role/Ec2InstanceMakerMcpServer"
            ]
        },
        {
            "Sid": "DenyIdentityCreationOutright",
            "Effect": "Deny",
            "Action": [
                "iam:CreateUser",
                "iam:CreateAccessKey",
                "iam:CreateLoginProfile",
                "iam:UpdateLoginProfile",
                "iam:CreateSAMLProvider",
                "iam:CreateOpenIDConnectProvider",
                "iam:CreateAccountAlias",
                "organizations:*",
                "account:*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "EC2ReadOnly",
            "Effect": "Allow",
            "Action": [
                "ec2:Describe*",
                "ec2:GetPasswordData",
                "ec2:GetConsoleOutput"
            ],
            "Resource": "*"
        },
        {
            "Sid": "EC2BuildAndTeardown",
            "Effect": "Allow",
            "Action": [
                "ec2:RunInstances",
                "ec2:RequestSpotInstances",
                "ec2:CancelSpotInstanceRequests",
                "ec2:TerminateInstances",
                "ec2:StartInstances",
                "ec2:StopInstances",
                "ec2:RebootInstances",
                "ec2:CreateTags",
                "ec2:DeleteTags",
                "ec2:CreateSecurityGroup",
                "ec2:DeleteSecurityGroup",
                "ec2:AuthorizeSecurityGroupIngress",
                "ec2:AuthorizeSecurityGroupEgress",
                "ec2:RevokeSecurityGroupIngress",
                "ec2:CreateKeyPair",
                "ec2:DeleteKeyPair",
                "ec2:CreatePlacementGroup",
                "ec2:DeletePlacementGroup",
                "ec2:CreateVolume",
                "ec2:AttachVolume",
                "ec2:DeleteVolume",
                "ec2:ModifyVolumeAttribute",
                "ec2:ModifyInstanceAttribute",
                "ec2:CreateImage",
                "ec2:DeregisterImage",
                "ec2:DeleteSnapshot",
                "ec2:CreateNetworkInterface",
                "ec2:DeleteNetworkInterface",
                "ec2:ModifyNetworkInterfaceAttribute"
            ],
            "Resource": "*"
        },
        {
            "Sid": "IAMScopedToThePrefixNamespace",
            "Effect": "Allow",
            "Action": [
                "iam:CreateRole",
                "iam:DeleteRole",
                "iam:GetRole",
                "iam:PutRolePolicy",
                "iam:DeleteRolePolicy",
                "iam:GetRolePolicy",
                "iam:ListRolePolicies",
                "iam:CreateInstanceProfile",
                "iam:DeleteInstanceProfile",
                "iam:GetInstanceProfile",
                "iam:AddRoleToInstanceProfile",
                "iam:RemoveRoleFromInstanceProfile",
                "iam:ListInstanceProfilesForRole",
                "iam:TagRole",
                "iam:TagInstanceProfile"
            ],
            "Resource": [
                "arn:aws:iam::<AWS_ACCOUNT_ID>:role/<EC2_IAM_PREFIX>-*",
                "arn:aws:iam::<AWS_ACCOUNT_ID>:instance-profile/<EC2_IAM_PREFIX>-*"
            ]
        },
        {
            "Sid": "PassOnlyRolesInThePrefixNamespace",
            "Effect": "Allow",
            "Action": "iam:PassRole",
            "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/<EC2_IAM_PREFIX>-*",
            "Condition": {
                "StringEquals": {
                    "iam:PassedToService": "ec2.amazonaws.com"
                }
            }
        },
        {
            "Sid": "SelfInspectionForVerifyMcpCredentials",
            "Effect": "Allow",
            "Action": [
                "iam:SimulatePrincipalPolicy",
                "iam:GetUser",
                "iam:ListAttachedRolePolicies",
                "sts:GetCallerIdentity"
            ],
            "Resource": "*"
        },
        {
            "Sid": "SNSScopedToThePrefixNamespace",
            "Effect": "Allow",
            "Action": [
                "sns:CreateTopic",
                "sns:DeleteTopic",
                "sns:Subscribe",
                "sns:Publish",
                "sns:GetTopicAttributes",
                "sns:ListSubscriptionsByTopic"
            ],
            "Resource": "arn:aws:sns:*:<AWS_ACCOUNT_ID>:<EC2_IAM_PREFIX>-*"
        },
        {
            "Sid": "CloudWatchLogsScopedToTheToolkitNamespace",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:DeleteLogGroup",
                "logs:PutRetentionPolicy",
                "logs:DescribeLogGroups",
                "logs:DescribeLogStreams",
                "logs:GetLogEvents",
                "logs:FilterLogEvents"
            ],
            "Resource": "arn:aws:logs:*:<AWS_ACCOUNT_ID>:log-group:/ec2instancemaker/*"
        },
        {
            "Sid": "SessionManagerAccessToManagedInstancesOnly",
            "Effect": "Allow",
            "Action": [
                "ssm:StartSession"
            ],
            "Resource": "arn:aws:ec2:*:<AWS_ACCOUNT_ID>:instance/*",
            "Condition": {
                "StringEquals": {
                    "ssm:resourceTag/ManagedBy": "Ec2InstanceMaker"
                }
            }
        },
        {
            "Sid": "SessionManagerSupportingCalls",
            "Effect": "Allow",
            "Action": [
                "ssm:StartSession",
                "ssm:TerminateSession",
                "ssm:ResumeSession",
                "ssm:DescribeSessions",
                "ssm:GetConnectionStatus",
                "ssm:DescribeInstanceInformation",
                "ssm:SendCommand",
                "ssm:GetCommandInvocation",
                "ssm:ListCommandInvocations"
            ],
            "Resource": [
                "arn:aws:ssm:*::document/AWS-StartInteractiveCommand",
                "arn:aws:ssm:*::document/AWS-StartPortForwardingSession",
                "arn:aws:ssm:*::document/AWS-RunShellScript",
                "arn:aws:ssm:*:<AWS_ACCOUNT_ID>:session/*"
            ]
        }
    ]
}
